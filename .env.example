# PromptCrafter — environment template
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.

# ── Lock screen passcode (bcrypt hash) ─────────────────────────────────────
# Generate with:   node -e "console.log(require('bcryptjs').hashSync('your-passcode', 10))"
# Default passcode that ships if this is empty:  craft-2026
PC_PASSCODE_HASH=

# ── Vault encryption key (32 raw bytes, base64-encoded) ────────────────────
# Used to AES-256-GCM-encrypt provider API keys at rest in the local SQLite file.
# Generate with:   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Default that ships if this is empty:  random per first boot, written to data/.vault-key
PC_VAULT_KEY=

# ── Session cookie HMAC secret ─────────────────────────────────────────────
# Signs the auth cookie. Generate the same way as PC_VAULT_KEY.
PC_SESSION_SECRET=

# ── Optional: where to put the SQLite file ─────────────────────────────────
# Default: ./data/promptcrafter.db
PC_DB_PATH=
